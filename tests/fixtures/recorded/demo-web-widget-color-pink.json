[
  {
    "apiVersion": "apiextensions.k8s.io/v1",
    "kind": "CustomResourceDefinition",
    "metadata": {
      "name": "widgets.example.com"
    },
    "spec": {
      "group": "example.com",
      "names": {
        "kind": "Widget",
        "plural": "widgets",
        "singular": "widget"
      },
      "scope": "Namespaced",
      "versions": [
        {
          "name": "v1",
          "schema": {
            "openAPIV3Schema": {
              "properties": {
                "spec": {
                  "properties": {
                    "color": {
                      "enum": [
                        "red",
                        "green",
                        "blue"
                      ],
                      "type": "string"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "size": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "size"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "served": true,
          "storage": true,
          "subresources": {
            "status": {}
          }
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "data": {
      "message": "from-sub"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "web-sub"
    }
  },
  {
    "apiVersion": "v1",
    "data": {
      "greeting": "hello",
      "kubeVersion": "v1.37.0"
    },
    "kind": "ConfigMap",
    "metadata": {
      "creationTimestamp": null,
      "name": "web-demo",
      "namespace": "apps"
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "web-demo",
      "namespace": "apps"
    },
    "rules": [
      {
        "apiGroups": [
          "example.com"
        ],
        "resources": [
          "widgets"
        ],
        "verbs": [
          "get",
          "list",
          "watch"
        ]
      }
    ]
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "web",
        "app.kubernetes.io/name": "demo"
      },
      "name": "web-demo"
    },
    "spec": {
      "ports": [
        {
          "port": 80,
          "targetPort": 8080
        }
      ],
      "selector": {
        "app.kubernetes.io/instance": "web",
        "app.kubernetes.io/name": "demo"
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "app.kubernetes.io/instance": "web",
        "app.kubernetes.io/name": "demo"
      },
      "name": "web-demo",
      "namespace": "apps"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/instance": "web",
          "app.kubernetes.io/name": "demo"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/instance": "web",
            "app.kubernetes.io/name": "demo"
          }
        },
        "spec": {
          "containers": [
            {
              "image": "nginx:1.27",
              "name": "web",
              "ports": [
                {
                  "containerPort": 8080
                }
              ],
              "volumeMounts": [
                {
                  "mountPath": "/etc/demo",
                  "name": "config"
                }
              ]
            }
          ],
          "volumes": [
            {
              "configMap": {
                "defaultMode": 420,
                "name": "web-demo"
              },
              "name": "config"
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "example.com/v1",
    "kind": "Widget",
    "metadata": {
      "name": "web-demo"
    },
    "spec": {
      "color": "pink",
      "enabled": true,
      "size": 3
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "annotations": {
        "helm.sh/hook": "test"
      },
      "name": "web-demo-test"
    },
    "spec": {
      "containers": [
        {
          "command": [
            "wget",
            "web-demo:80"
          ],
          "image": "busybox",
          "name": "wget"
        }
      ],
      "restartPolicy": "Never"
    }
  },
  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "annotations": {
        "helm.sh/hook": "pre-install,pre-upgrade",
        "helm.sh/hook-delete-policy": "before-hook-creation"
      },
      "name": "web-demo-migrate"
    },
    "spec": {
      "template": {
        "spec": {
          "containers": [
            {
              "command": [
                "true"
              ],
              "image": "busybox",
              "name": "migrate"
            }
          ],
          "restartPolicy": "Never"
        }
      }
    }
  }
]
